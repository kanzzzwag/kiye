# copy to .env and change both secrets (the service refuses to start with the example key)
API_KEY=change-me-to-a-long-random-string
POSTGRES_PASSWORD=change-me-too

# optional
# RATE_LIMIT_PER_MIN=20          # POST /api/v1/analyze per API key + IP
# CORS_ORIGINS=                  # extra allowed origins, comma separated; empty = same origin only
# SEED_DEMO=true                 # demo desks, employees and shifts on first start
# WORKER_CPUS=4                  # CPU limit of the analysis worker
# WORKER_THREADS=4               # torch threads in the worker
# PIP_INDEX_URL=https://pypi.org/simple   # build-time only: a closer PyPI mirror if the default is slow
