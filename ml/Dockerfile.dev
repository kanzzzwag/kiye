# Dev/eval image: same Python as backend + tools for data inspection. Not used in production.
FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir numpy opencv-python-headless==4.10.0.84 openpyxl pandas pyyaml
WORKDIR /work
